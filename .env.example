# OpenBB Data Provider API Keys
# Copy this to .env and fill in your keys
# These get loaded into ~/.openbb_platform/user_settings.json

# Free tier - recommended starting point
FMP_API_KEY=                    # https://financialmodelingprep.com/developer
POLYGON_API_KEY=                # https://polygon.io/
TIINGO_TOKEN=                   # https://www.tiingo.com/
ALPHA_VANTAGE_API_KEY=          # https://www.alphavantage.co/
FRED_API_KEY=                   # https://fred.stlouisfed.org/docs/api/api_key.html

# Paid / institutional
INTRINIO_API_KEY=               # https://intrinio.com/
BENZINGA_API_KEY=               # https://www.benzinga.com/apis
TRADINGECONOMICS_API_KEY=       # https://tradingeconomics.com/api
